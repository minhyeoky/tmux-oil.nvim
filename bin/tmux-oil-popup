#!/usr/bin/env python3
"""Open tmux-oil in a display-popup sized to its content.

display-popup takes its size at launch, so the size is computed here, before nvim starts.
$TMUX_OIL_SOCKET adds -L <socket> to every tmux call.

  --print               print "rows cols" and exit
  --border LINES        display-popup -b: single, rounded, double, heavy, simple, padded, none
                        (default: the popup-border-lines option)
  --border-style STYLE  display-popup -S, e.g. "fg=#665c54" (default: popup-border-style)
  --title TEXT          border title (default " tmux-oil "; "" for none; literal, not a format)
"""
import argparse
import os
import subprocess
import sys
import unicodedata


def tmux(*args):
    cmd = ["tmux"]
    if os.environ.get("TMUX_OIL_SOCKET"):
        cmd += ["-L", os.environ["TMUX_OIL_SOCKET"]]
    r = subprocess.run(cmd + list(args), capture_output=True, text=True)
    return r.stdout.rstrip("\n") if r.returncode == 0 else ""


def width(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def size():
    sessions = {}  # session_id -> [name, window count]
    wlines = []
    out = tmux("list-windows", "-a", "-F",
               "#{session_id}\x1f#{session_name}\x1f#{window_name}\x1f#{pane_title}\x1f#{host}"
               "\x1f#{window_active}\x1f#{window_panes}")
    # split("\n") only: splitlines() also breaks on U+2028/U+0085 etc., which a pane title may carry.
    recs = [rec.split("\x1f") for rec in out.split("\n")] if out else []
    # A change-preview mark ("✎ rename", "→ session $N") takes its cells from the line's title;
    # a line without one needs the room reserved here.
    mark = max([len("✎ rename")] + [len("→ session ") + len(r[0]) for r in recs])
    for sid, sname, wname, title, host, active, panes in recs:
        sessions.setdefault(sid, [sname, 0])[1] += 1
        if title == host:  # the plugin hides a title equal to the host name
            title = ""
        # index, icon, name, " ●" if active, " ⊞N" if 2+ panes, gap, title — as view.lua lays it out
        extra = (2 if active == "1" else 0) + (2 + len(panes) if int(panes or 1) >= 2 else 0)
        wlines.append(1 + 3 + 2 + width(wname) + extra + max(1 + width(title), 1 + mark))
    n = len(sessions)
    # content + border + nvim's cmdline (no statusline in the popup) + 2 lines of headroom
    # for a new session/window typed in
    rows = n + len(wlines) + max(0, n - 1) + 2 + 1 + 2
    cols = 2 + 1 + max(
        [width(name) + 1 + width("  %d window%s · attached" % (c, "" if c == 1 else "s"))
         for name, c in sessions.values()] + wlines + [0])
    rows = max(rows, 6)
    cols = max(cols, 40)
    dims = tmux("display-message", "-p", "#{client_height} #{client_width}").split()
    if len(dims) == 2 and all(d.isdigit() for d in dims):
        rows = min(rows, max(6, int(dims[0]) - 2))
        cols = min(cols, max(40, int(dims[1]) - 4))
    return rows, cols


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--print", action="store_true", help='print "rows cols" and exit')
    ap.add_argument("--border", choices=["single", "rounded", "double", "heavy", "simple", "padded", "none"],
                    help="border lines (display-popup -b)")
    ap.add_argument("--border-style", metavar="STYLE", help="border style (display-popup -S)")
    ap.add_argument("--title", default=" tmux-oil ", metavar="TEXT", help='border title; "" for none')
    opts = ap.parse_args()
    rows, cols = size()
    if opts.print:
        print(rows, cols)
        return
    # display-popup -d expands formats: a literal "#" in the path must be doubled.
    cwd = (tmux("display-message", "-p", "#{pane_current_path}") or os.getcwd()).replace("#", "##")
    inner = "nvim -c 'lua require(\"tmux-oil\").open({ popup = true })'"
    sock = ["-L", os.environ["TMUX_OIL_SOCKET"]] if os.environ.get("TMUX_OIL_SOCKET") else []
    # display-popup runs the command with the server's environment, not this process's: forward
    # what the popup's nvim reads (its config via NVIM_APPNAME; the demo's socket and checkout).
    env = []
    for key in ("NVIM_APPNAME", "TMUX_OIL_SOCKET", "TMUX_OIL_ROOT"):
        if os.environ.get(key):
            env += ["-e", "%s=%s" % (key, os.environ[key])]
    border = []
    if opts.border:
        border += ["-b", opts.border]
    if opts.border_style:
        border += ["-S", opts.border_style]
    if opts.title:
        border += ["-T", opts.title.replace("#", "##")]  # -T is a format: keep the text literal
    os.execvp("tmux", ["tmux"] + sock + ["display-popup", "-E"] + border + env
              + ["-w", str(cols), "-h", str(rows), "-d", cwd, inner])


main()
